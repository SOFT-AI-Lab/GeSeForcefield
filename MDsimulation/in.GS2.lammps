# relax Ge–Se melt
units           metal
dimension       3
processors      * * *
boundary        p p p

# create configuration
atom_style	atomic
read_data	GeSe2.dat

# potential
include		pot.mod

# PDF
compute         myPDF all rdf 800 1 1 1 2 2 2 * * cutoff 8.0
shell           mkdir pdf

# relax
minimize        1.0e-10 1.0e-10 100000 100000
velocity all    create 2000.0 5812775 dist gaussian
fix             1 all nvt temp 2000 2000 0.1
run             25000
unfix           1
fix             1 all nvt temp 1373 1373 0.1
run             25000
unfix           1
fix             1 all nvt temp 1050 1050 0.1
run             25000
unfix           1
fix             1 all nvt temp 1050 300 0.1
run             75000
unfix           1

# compute PDF
#dump            3 all custom 1000 md.lammpstrj id type x y z
reset_timestep  0
fix             2 all ave/time 1 84000 100000 c_myPDF[*] file tmp.dat mode vector
fix             1 all nvt temp 300 300 0.1
run             100000
unfix           1
unfix           2
#undump          3
shell           mv tmp.dat pdf/pdf.dat

write_data      GS2b.dat
